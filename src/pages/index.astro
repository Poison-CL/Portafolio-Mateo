<style>
	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(-100% / 2));
		}
	}

	.animate-marquee {
		animation: marquee 20s linear infinite;
		width: fit-content;
	}

	@keyframes pulse {
		0%, 100% {
			opacity: 1;
		}
		50% {
			opacity: 0.5;
		}
	}

	.animate-pulse {
		animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}

	@keyframes float-slow {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-12px); }
	}

	.animate-float-slow {
		animation: float-slow 4s ease-in-out infinite;
	}

	.pixelated {
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		image-rendering: crisp-edges;
	}

	@keyframes typing {
		from { width: 0; }
		to { width: 100%; }
	}

	@keyframes blink-caret {
		from, to { border-color: transparent; }
		50% { border-color: currentColor; }
	}

	@keyframes invert-colors {
		0% { background-color: white; color: black; }
		50% { background-color: black; color: white; }
		100% { background-color: black; color: white; }
	}

	@keyframes slide-up-reveal {
		0% { transform: translateY(0); }
		100% { transform: translateY(-100%); }
	}

	.preloader-typing {
		border-right: 3px solid;
		white-space: nowrap;
		overflow: hidden;
		animation: typing 0.8s steps(15, end) forwards, blink-caret .75s step-end infinite;
	}

	.preloader-invert {
		animation: invert-colors 0.4s cubic-bezier(0.645, 0.045, 0.355, 1.000) forwards;
	}

	.preloader-exit {
		animation: slide-up-reveal 0.8s cubic-bezier(0.77, 0, 0.175, 1) forwards;
	}
</style>

