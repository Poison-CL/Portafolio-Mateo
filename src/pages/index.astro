---
import Layout from '../layouts/Layout.astro';

const featuredProjects = [
	{
		name: 'NexSecure',
		nameJP: 'ネクセキュア',
		description: 'Agencia de desarrollo web y auditorías de seguridad.',
		homepage: 'https://desarrolloweb.nexsecure.cl/',
		html_url: 'https://github.com/Poison-CL',
		language: 'TypeScript',
		japaneseTag: '企業 : CORPORATE',
		isOnline: true,
		isFeatured: true,
	},
	{
		name: 'Japimax',
		nameJP: 'ジャピマックス',
		description: 'Centro de Bowling y Entretenimiento Familiar en Santiago, Barrio Universitario. 13 pistas de bowling Brunswick.',
		homepage: 'https://japimax.com/',
		html_url: 'https://github.com/Poison-CL',
		language: 'Web',
		japaneseTag: 'エンターテインメント : ENTERTAINMENT',
		isOnline: true,
		isFeatured: true,
	},
	{
		name: 'StrikeBowler',
		nameJP: 'ストライクボウラー',
		description: 'Servicios técnicos profesionales para negocios de bowling. Más de 24 años de experiencia en instalación, reparación y capacitación.',
		homepage: 'https://strikebowler.cl/',
		html_url: 'https://github.com/Poison-CL',
		language: 'Web',
		japaneseTag: 'サービス : SERVICE',
		isOnline: true,
		isFeatured: true,
	},
	{
		name: 'VENT',
		nameJP: 'ベント',
		description: 'Plataforma de e-commerce con tienda, galería y archivo. Sistema de gestión de pedidos y catálogo digital.',
		homepage: 'https://web-vent.vercel.app/',
		html_url: 'https://github.com/Poison-CL',
		language: 'Web',
		japaneseTag: 'Eコマース : E-COMMERCE',
		isOnline: true,
		isFeatured: true,
	},
];


const techStack = ['Astro', 'Tailwind', 'Python', 'Kali Linux', 'Flask', 'Godot', 'Boostrap', 'Metasploitable', 'HTML5','CSS','JS','PHP','Django','MySQL'];
---

<Layout title="Mateo Gijon - Desarrollo Web" description="Portafolio de Mateo Gijon. Desarrollador Web Freelance, creador de NexSecure.">
	<!-- PRELOADER -->
	<div id="japan-preloader" class="fixed inset-0 z-[9999] flex items-center justify-center bg-white pointer-events-none">
		<div class="overflow-hidden whitespace-nowrap">
			<h2 id="preloader-text" class="font-mono text-2xl md:text-4xl font-bold text-black">
				[ ロード中... ]
			</h2>
		</div>
	</div>
	<noscript>
		<style>#japan-preloader { display: none !important; }</style>
	</noscript>

	<!-- HEADER -->
	<header class="border-b border-neutral-900 bg-paper sticky top-0 z-50">
		<nav class="container mx-auto px-4 py-3 md:py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-0">
			<div class="flex items-center gap-2">
				<div class="flex flex-col">
					<span class="text-lg md:text-xl font-bold font-mono">POISON-CL</span>
					<span class="text-xs font-mono text-neutral-500">ポイズン・シーエル</span>
				</div>
				<span class="text-lg md:text-xl">(▀̿Ĺ̯▀̿ ̿)</span>
			</div>
			<div class="flex flex-wrap gap-4 md:gap-6">
				<a href="#proyectos" class="text-ink hover:underline transition-all duration-200 ease-out flex flex-col items-start">
					<span class="text-xs font-mono text-neutral-500 leading-tight">案件</span>
					<span class="leading-tight text-sm md:text-base">Proyectos</span>
				</a>
				<a href="#stack" class="text-ink hover:underline transition-all duration-200 ease-out flex flex-col items-start">
					<span class="text-xs font-mono text-neutral-500 leading-tight">スキル</span>
					<span class="leading-tight text-sm md:text-base">Stack</span>
				</a>
				<a href="#contacto" class="text-ink hover:underline transition-all duration-200 ease-out flex flex-col items-start">
					<span class="text-xs font-mono text-neutral-500 leading-tight">お問い合わせ</span>
					<span class="leading-tight text-sm md:text-base">Contacto</span>
				</a>
			</div>
		</nav>
	</header>

	<!-- MAIN -->
	<main class="overflow-x-hidden">
		<!-- HERO -->
		<section class="container mx-auto px-4 min-h-[calc(100vh-80px)] relative flex flex-col justify-center">
			<div class="absolute top-2 right-2 md:top-0 md:right-4 lg:right-8">
				<span class="font-mono text-xs border border-neutral-900 bg-paper px-2 py-1 md:px-3 shadow-hard text-neutral-500">
					[ システム正常 : ONLINE ]
				</span>
			</div>
			
			<div class="max-w-prose text-left">
				<h1 class="text-4xl md:text-6xl lg:text-8xl font-bold mb-3 text-left font-sans break-words">
					SOY 
				</h1>
				<h1 class="text-4xl md:text-6xl lg:text-8xl font-bold mb-3 text-left font-sans break-words">
					MATEO GIJON
				</h1>
				<p class="font-mono text-xs md:text-sm text-neutral-500 mb-4 md:mb-6 text-left break-words">
					サイバーセキュリティ // ウェブ開発
				</p>
				<p class="text-base md:text-lg lg:text-xl text-left max-w-prose mb-6 md:mb-8 break-words">
					Web Developer. Construyendo Webs & Software desde los 17 años.
				</p>
				<div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
					<a 
						href="https://github.com/Poison-CL" 
						target="_blank" 
						rel="noopener noreferrer"
						class="w-full sm:w-auto text-center border border-neutral-900 bg-ink text-paper px-6 py-3 font-mono shadow-hard transition-all duration-200 ease-out hover:translate-x-1 hover:translate-y-1 hover:shadow-none"
					>
						Ver GitHub
					</a>
					<a 
						href="#perfil"
						class="w-full sm:w-auto text-center border-2 border-neutral-900 bg-transparent text-ink px-6 py-3 font-mono shadow-hard transition-all duration-200 ease-out hover:translate-x-1 hover:translate-y-1 hover:shadow-none hover:bg-neutral-900 hover:text-paper"
					>
						Sobre mí <span class="text-xs">[ 私について ]</span>
					</a>
					<span class="font-mono text-xs text-neutral-500">アクセス</span>
				</div>
			</div>
		</section>

		<!-- TECH_STACK -->
		<section id="stack" class="border-y border-neutral-900 bg-paper py-8 overflow-hidden">
			<div class="flex gap-8 animate-marquee whitespace-nowrap">
				{techStack.map((tech) => (
					<span key={tech} class="font-mono text-sm border border-neutral-900 px-4 py-2 bg-paper shadow-hard inline-block flex-shrink-0">
						{tech}
					</span>
				))}
				{techStack.map((tech) => (
					<span key={`${tech}-dup`} class="font-mono text-sm border border-neutral-900 px-4 py-2 bg-paper shadow-hard inline-block flex-shrink-0">
						{tech}
					</span>
				))}
			</div>
		</section>

		<!-- PERFIL -->
		<section id="perfil" class="container mx-auto px-4 py-8 md:py-16 relative">
			<div class="relative flex items-center py-6 mb-6 md:mb-8">
				<span class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 whitespace-nowrap text-6xl md:text-8xl font-black text-neutral-200/40 -z-10 select-none pointer-events-none">
					プロフィール
				</span>
				<div class="relative z-10 text-left">
					<p class="text-xs font-mono text-neutral-500 mb-2">プロフィール</p>
					<h2 class="text-3xl md:text-4xl font-bold text-left break-words">PERFIL</h2>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 relative z-10">
				<div class="md:col-span-1 order-1 md:order-1">
					<div class="w-full aspect-square border-2 border-neutral-900 bg-paper shadow-[4px_4px_0px_#000] overflow-hidden">
						<img 
							src="https://cdn.discordapp.com/attachments/1297263543053451274/1473832655790276689/IMG_2090.jpg?ex=6997a51f&is=6996539f&hm=9b64a7ef549d0a2d0aaa8abcfdeb2a11522dd69ad42975347845496201791cdf&" 
							alt="Mateo Gijon - Perfil" 
							class="w-full h-full object-cover pixelated"
						/>
					</div>
				</div>

				<div class="md:col-span-2 order-2 md:order-2">
					<div class="border-2 border-neutral-900 bg-paper shadow-[4px_4px_0px_#000] p-4 md:p-6">
						<div class="space-y-4 text-left">
							<div>
								<p class="font-mono text-xs text-neutral-500 mb-1">名前</p>
								<p class="font-mono text-sm font-bold mb-1">Nombre [ 名前 ]:</p>
								<p class="font-sans text-base">MATEO GIJON</p>
							</div>

							<div>
								<p class="font-mono text-xs text-neutral-500 mb-1">拠点</p>
								<p class="font-mono text-sm font-bold mb-1">Base [ 拠点 ]:</p>
								<p class="font-sans text-base">Santiago, CL</p>
							</div>

							<div>
								<p class="font-mono text-xs text-neutral-500 mb-1">状態</p>
								<p class="font-mono text-sm font-bold mb-1">Status [ 状態 ]:</p>
								<p class="font-sans text-base max-w-prose">Desarrollador Web Freelance en NexSecure. Especialista en creación de sitios desde cero con enfoque en seguridad.</p>
							</div>

							<div>
								<p class="font-mono text-xs text-neutral-500 mb-1">ログ</p>
								<p class="font-mono text-sm font-bold mb-1">Registro de Actividad [ ログ ]:</p>
								<p class="font-sans text-base max-w-prose text-left">
									Líder de la comunidad Alt F4, gestionando eventos universitarios y "tarreos". Instructor de talleres de videojuegos en el CITT.
								</p>
							</div>

							<div>
								<p class="font-mono text-xs text-neutral-500 mb-1">履歴</p>
								<p class="font-mono text-sm font-bold mb-1">Experiencia Técnica [ 履歴 ]:</p>
								<p class="font-sans text-base max-w-prose text-left">
									Experiencia previa en el área de Informática de la Municipalidad de San Joaquín. Soporte y gestión tecnológica.
								</p>
							</div>

							<div>
								<p class="font-mono text-xs text-neutral-500 mb-1">サブタスク</p>
								<p class="font-mono text-sm font-bold mb-1">Intereses & Logros [ サブタスク ]:</p>
								<p class="font-sans text-base max-w-prose text-left">
									Música y Gaming.
								</p>
								<p class="font-sans text-base max-w-prose text-left mt-2">
									<span class="font-mono text-sm">League of Legends:</span> <span class="font-bold text-amber-600 font-mono">Master [ マスター ]</span>
								</p> 
								<span class="font-mono text-sm">Apex Legends:</span> <span class="font-bold text-amber-600 font-mono">Master [ マスター ]</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- PROYECTOS -->
		<section id="proyectos" class="container mx-auto px-4 py-8 md:py-16 relative">
			<div class="relative flex items-center py-6 mb-6 md:mb-8">
				<span class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 whitespace-nowrap text-6xl md:text-8xl font-black text-neutral-200/40 -z-10 select-none pointer-events-none">
					プロジェクト
				</span>
				<div class="relative z-10 text-left">
					<h2 class="text-3xl md:text-4xl font-bold text-left break-words">Proyectos</h2>
				</div>
			</div>
			<div id="github-repos-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 lg:gap-8 relative z-10">
				<div class="col-span-full text-center py-10 font-mono text-neutral-500 animate-pulse">
					[ CONECTANDO CON LOS SERVIDORES DE GITHUB... ]
				</div>
			</div>
		</section>

		<!-- CONTACTO -->
		<section id="contacto-terminal" class="container mx-auto px-4 py-8 md:py-16 max-w-4xl">
			<div class="relative flex items-center py-6 mb-6 md:mb-8">
				<span class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 whitespace-nowrap text-6xl md:text-8xl font-black text-neutral-200/40 -z-10 select-none pointer-events-none">
					お問い合わせ
				</span>
				<div class="relative z-10 text-left">
					<h2 class="text-3xl md:text-4xl font-bold text-left break-words font-mono">CONTACTO</h2>
				</div>
			</div>
			
			<div class="bg-neutral-950 border-2 border-neutral-800 shadow-[4px_4px_0px_#ccc] overflow-hidden">
				<div class="bg-neutral-900 border-b border-neutral-800 px-4 py-2 flex items-center justify-between">
					<div class="flex items-center gap-2">
						<div class="flex gap-1.5">
							<div class="w-3 h-3 rounded-full bg-red-600"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-600"></div>
							<div class="w-3 h-3 rounded-full bg-green-600"></div>
						</div>
						<span class="font-mono text-xs text-neutral-400 ml-3">root@system:~ / 通信</span>
					</div>
				</div>

				<div class="p-4 md:p-6 space-y-4">
					<div class="space-y-2 font-mono text-xs md:text-sm text-neutral-400">
						<p>> Inicializando protocolo de conexión seguro... <span class="text-green-500">[OK]</span></p>
						<p>> Estableciendo enlace con MATEO.DEV... <span class="text-green-500">[OK]</span></p>
						<p>> Sistema de comunicación listo. Esperando input del usuario...</p>
					</div>

					<form id="terminal-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-4 mt-6">
						<input type="hidden" name="access_key" value="c7fbeceb-e3c0-4282-89d3-1cbb43f27fc4" />
						<input type="hidden" name="subject" value="Nuevo contacto clasificado desde MATEO.DEV" />
						<input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

						<div class="flex items-center flex-wrap">
							<span class="text-green-500 font-mono text-sm md:text-base">guest@user:~$</span>
							<input 
								type="text" 
								name="name"
								placeholder="ingresa_tu_nombre" 
								required
								class="bg-transparent border-none outline-none focus:ring-0 text-green-400 font-mono text-sm md:text-base w-full md:w-auto flex-1 min-w-[200px] ml-2 placeholder-neutral-700"
							/>
						</div>

						<div class="flex items-center flex-wrap">
							<span class="text-green-500 font-mono text-sm md:text-base">guest@user:~$</span>
							<input 
								type="email" 
								name="email"
								placeholder="ingresa_tu_email_aqui" 
								required
								class="bg-transparent border-none outline-none focus:ring-0 text-green-400 font-mono text-sm md:text-base w-full md:w-auto flex-1 min-w-[200px] ml-2 placeholder-neutral-700"
							/>
						</div>

						<div class="flex items-start">
							<span class="text-green-500 font-mono text-sm md:text-base mt-1">guest@user:~$</span>
							<textarea 
								name="message"
								placeholder="escribe_tu_mensaje_aqui" 
								required
								rows="4"
								class="bg-transparent border-none outline-none focus:ring-0 text-green-400 font-mono text-sm md:text-base w-full ml-2 placeholder-neutral-700 resize-none"
							></textarea>
						</div>

						<div class="pt-2">
							<button 
								id="submit-btn"
								type="submit"
								class="text-green-500 font-mono text-sm md:text-base hover:bg-green-500 hover:text-neutral-950 hover:animate-pulse transition-all duration-200 ease-out cursor-pointer bg-transparent border-none outline-none px-4 py-2 rounded"
							>
								[ EJECUTAR TRANSMISIÓN ]
							</button>
						</div>
					</form>

					<div class="font-mono text-xs text-neutral-600 mt-4 pt-4 border-t border-neutral-800">
						<p>> Estado: <span class="text-green-500">LISTO</span> | Protocolo: <span class="text-green-500">HTTPS</span> | Puerto: <span class="text-green-500">443</span></p>
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- TEEMO -->
	<div id="teemo-container" class="fixed bottom-4 right-4 z-50 select-none pointer-events-auto w-20 h-20 md:w-24 md:h-24">
		<div id="teemo-tooltip" class="absolute bottom-full right-0 mb-4 opacity-0 invisible transition-all duration-300 ease-out transform translate-y-4 pointer-events-none">
			<div class="bg-white border-2 border-neutral-900 shadow-[4px_4px_0px_#000] p-3 font-mono text-sm whitespace-nowrap relative">
				<div class="absolute -bottom-2 right-8 w-4 h-4 bg-white border-b-2 border-r-2 border-neutral-900 transform rotate-45"></div>
				<span class="text-green-600 font-bold animate-pulse">●</span> <span id="teemo-dialog" class="ml-1">[ 監視中 : TEEMO ]</span>
			</div>
		</div>
		<div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-16 h-4 bg-black/20 blur-sm rounded-full -z-10"></div>
		<img
			src="https://cdnb.artstation.com/p/assets/images/images/005/563/783/original/ivan-kohan-olguin-teemo.gif?1492008046"
			alt="System Daemon Guardián"
			class="w-full h-full object-contain pixelated relative z-10 animate-float-slow"
		/>
	</div>

	<!-- FOOTER -->
	<footer id="contacto" class="border-t border-neutral-900 bg-paper mt-20">
		<div class="container mx-auto px-4 py-8">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 text-left">
				<div class="flex-1">
					<p class="mb-2 font-mono text-sm">お問い合わせ // CONTACTO</p>
					
					<div class="mb-4">
						<div class="flex flex-wrap gap-4 items-center">
							<a 
								href="https://github.com/Poison-CL" 
								target="_blank" 
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 bg-white border-2 border-neutral-900 shadow-[4px_4px_0px_#000] px-4 py-2 font-mono text-sm transition-all duration-200 ease-out hover:translate-x-1 hover:translate-y-1 hover:shadow-none whitespace-nowrap"
							>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="flex-shrink-0">
									<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23 1.957-.544 4.049-.544 6.006 0 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
								</svg>
								<span>GITHUB <span class="text-xs text-neutral-500">[ ギットハブ ]</span></span>
							</a>
							<a 
								href="https://discord.com/users/peruanochitero" 
								target="_blank" 
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 bg-white border-2 border-neutral-900 shadow-[4px_4px_0px_#000] px-4 py-2 font-mono text-sm transition-all duration-200 ease-out hover:translate-x-1 hover:translate-y-1 hover:shadow-none whitespace-nowrap"
							>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="flex-shrink-0">
									<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.295-.444.697-.608 1.112a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.111.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C2.4 6.45 1.896 8.51 1.756 10.544a.082.082 0 0 0 .031.058 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.007-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.058c-.2-2.13-.793-4.175-1.888-6.144a.05.05 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
								</svg>
								<span>DISCORD <span class="text-xs text-neutral-500">[ ディスコード ]</span></span>
							</a>
							<a 
								href="https://www.instagram.com/prbleems/" 
