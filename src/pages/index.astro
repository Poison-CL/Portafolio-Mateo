---
import Layout from '../layouts/Layout.astro';

const featuredProjects = [
	{
		name: 'NexSecure',
		nameJP: 'ネクセキュア',
		description: 'Agencia de desarrollo web y auditorías de seguridad.',
		homepage: 'https://desarrolloweb.nexsecure.cl/',
		html_url: 'https://github.com/Poison-CL',
		language: 'TypeScript',
		japaneseTag: '企業 : CORPORATE',
		isOnline: true,
		isFeatured: true,
	},
	{
		name: 'Japimax',
		nameJP: 'ジャピマックス',
		description: 'Centro de Bowling y Entretenimiento Familiar en Santiago, Barrio Universitario. 13 pistas de bowling Brunswick.',
		homepage: 'https://japimax.com/',
		html_url: 'https://github.com/Poison-CL',
		language: 'Web',
		japaneseTag: 'エンターテインメント : ENTERTAINMENT',
		isOnline: true,
		isFeatured: true,
	},
	{
		name: 'StrikeBowler',
		nameJP: 'ストライクボウラー',
		description: 'Servicios técnicos profesionales para negocios de bowling. Más de 24 años de experiencia en instalación, reparación y capacitación.',
		homepage: 'https://strikebowler.cl/',
		html_url: 'https://github.com/Poison-CL',
		language: 'Web',
		japaneseTag: 'サービス : SERVICE',
		isOnline: true,
		isFeatured: true,
	},
	{
		name: 'VENT',
		nameJP: 'ベント',
		description: 'Plataforma de e-commerce con tienda, galería y archivo. Sistema de gestión de pedidos y catálogo digital.',
		homepage: 'https://web-vent.vercel.app/',
		html_url: 'https://github.com/Poison-CL',
		language: 'Web',
		japaneseTag: 'Eコマース : E-COMMERCE',
		isOnline: true,
		isFeatured: true,
	},
];


const techStack = ['Astro', 'Tailwind', 'Python', 'Kali Linux', 'Flask', 'Godot', 'Boostrap', 'Metasploitable', 'HTML5','CSS','JS','PHP','Django','MySQL'];
---

<Layout title="Mateo Gijon - Desarrollo Web" description="Portafolio de Mateo Gijon. Desarrollador Web Freelance, creador de NexSecure.">
	<!-- PRELOADER -->
	<div id="japan-preloader" class="fixed inset-0 z-[9999] flex items-center justify-center bg-white dark:bg-neutral-950 pointer-events-none">
		<div class="overflow-hidden whitespace-nowrap">
			<h2 id="preloader-text" class="font-mono text-2xl md:text-4xl font-bold text-black dark:text-white">
				[ ロード中... ]
			</h2>
		</div>
	</div>
	<noscript>
		<style>#japan-preloader { display: none !important; }</style>
	</noscript>

	<!-- HEADER -->
	<header class="border-b border-neutral-900 dark:border-neutral-700 bg-paper dark:bg-neutral-900 sticky top-0 z-50">
		<nav class="container mx-auto px-4 py-3 md:py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-0">
			<div class="flex items-center gap-2">
				<div class="flex flex-col">
					<span class="text-lg md:text-xl font-bold font-mono dark:text-white">POISON-CL</span>
					<span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">ポイズン・シーエル</span>
				</div>
				<span class="text-lg md:text-xl dark:text-white">(▀̿Ĺ̯▀̿ ̿)</span>
			</div>
			<div class="flex flex-wrap gap-1.5 sm:gap-4 md:gap-6 items-center">
				<a href="#proyectos" class="text-ink dark:text-white hover:underline transition-all duration-200 ease-out flex flex-col items-start">
					<span class="text-xs font-mono text-neutral-500 dark:text-neutral-400 leading-tight">案件</span>
					<span class="leading-tight text-sm md:text-base">Proyectos</span>
				</a>
				<a href="#stack" class="text-ink dark:text-white hover:underline transition-all duration-200 ease-out flex flex-col items-start">
					<span class="text-xs font-mono text-neutral-500 dark:text-neutral-400 leading-tight">スキル</span>
					<span class="leading-tight text-sm md:text-base">Stack</span>
				</a>
				<a href="#contacto" class="text-ink dark:text-white hover:underline transition-all duration-200 ease-out flex flex-col items-start">
					<span class="text-xs font-mono text-neutral-500 dark:text-neutral-400 leading-tight">お問い合わせ</span>
					<span class="leading-tight text-sm md:text-base">Contacto</span>
				</a>
				<button id="theme-toggle" type="button" class="border-2 border-black dark:border-white px-2 py-1 md:p-2 text-xs md:text-sm hover:-translate-y-1 hover:shadow-[2px_2px_0px_#000] dark:hover:shadow-[2px_2px_0px_#fff] transition-all bg-white dark:bg-black text-black dark:text-white font-mono flex items-center gap-1 md:gap-2 cursor-pointer">
					<span id="theme-icon-light" class="hidden dark:block">☀ LUZ</span>
					<span id="theme-icon-dark" class="block dark:hidden">☾ OSCURO</span>
				</button>
			</div>
		</nav>
	</header>

	<!-- MAIN -->
	<main class="overflow-x-hidden w-full max-w-[100vw]">
		<!-- HERO -->
		<section class="container mx-auto px-4 min-h-[calc(100vh-80px)] relative flex flex-col justify-center overflow-hidden w-full">
			<div class="absolute top-2 right-2 md:top-0 md:right-4 lg:right-8 max-w-[calc(100%-1rem)] overflow-hidden">
				<span class="font-mono text-xs border border-neutral-900 dark:border-neutral-700 bg-paper dark:bg-neutral-900 px-2 py-1 md:px-3 shadow-hard dark:shadow-[4px_4px_0px_#fff] text-neutral-500 dark:text-neutral-300 whitespace-nowrap text-ellipsis block">
					[ システム正常 : ONLINE ]
				</span>
			</div>
			
			<div class="max-w-prose text-left">
				<h1 class="text-3xl md:text-6xl lg:text-8xl font-bold mb-3 text-left font-sans break-words">
					SOY 
				</h1>
				<h1 class="text-3xl md:text-6xl lg:text-8xl font-bold mb-3 text-left font-sans break-words">
					MATEO GIJON
				</h1>
				<p class="font-mono text-xs md:text-sm text-neutral-500 dark:text-neutral-400 mb-4 md:mb-6 text-left break-words">
					サイバーセキュリティ // ウェブ開発
				</p>
				<p class="text-base md:text-lg lg:text-xl text-left max-w-prose mb-4 md:mb-6 break-words dark:text-white">
					Web Developer. Construyendo Webs & Software desde los 17 años.
				</p>
				<div class="mb-4 md:mb-6">
					<a 
						href="mailto:mateomartinezsem@gmail.com" 
						class="inline-flex items-center gap-2 font-mono text-sm md:text-base text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white hover:underline transition-all break-words"
					>
						<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
						</svg>
						<span class="break-all">mateomartinezsem@gmail.com</span>
					</a>
				</div>
				<div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
					<a 
						href="https://github.com/Poison-CL" 
						target="_blank" 
						rel="noopener noreferrer"
						class="w-[calc(100%-8px)] sm:w-auto text-center border border-neutral-900 dark:border-neutral-700 bg-ink dark:bg-white text-paper dark:text-black px-6 py-3 font-mono shadow-hard dark:shadow-[4px_4px_0px_#fff] transition-all duration-200 ease-out hover:translate-x-1 hover:translate-y-1 hover:shadow-none"
					>
						Ver GitHub
					</a>
					<a 
						href="#perfil"
						class="w-[calc(100%-8px)] sm:w-auto text-center border-2 border-neutral-900 dark:border-neutral-700 bg-transparent text-ink dark:text-white px-6 py-3 font-mono shadow-hard dark:shadow-[4px_4px_0px_#fff] transition-all duration-200 ease-out hover:translate-x-1 hover:translate-y-1 hover:shadow-none hover:bg-neutral-900 dark:hover:bg-neutral-100 hover:text-paper dark:hover:text-black"
					>
						Sobre mí <span class="text-xs">[ 私について ]</span>
					</a>
				</div>
			</div>
		</section>

		<!-- TECH_STACK -->
		<section id="stack" class="border-y border-neutral-900 dark:border-neutral-700 bg-paper dark:bg-neutral-900 py-8 overflow-hidden w-full">
			<div class="flex gap-8 animate-marquee whitespace-nowrap">
				{techStack.map((tech) => (
					<span key={tech} class="font-mono text-sm border border-neutral-900 dark:border-neutral-700 px-4 py-2 bg-paper dark:bg-neutral-800 shadow-hard dark:shadow-[4px_4px_0px_#fff] text-black dark:text-white inline-block flex-shrink-0">
						{tech}
					</span>
				))}
				{techStack.map((tech) => (
					<span key={`${tech}-dup`} class="font-mono text-sm border border-neutral-900 dark:border-neutral-700 px-4 py-2 bg-paper dark:bg-neutral-800 shadow-hard dark:shadow-[4px_4px_0px_#fff] text-black dark:text-white inline-block flex-shrink-0">
						{tech}
					</span>
				))}
			</div>
		</section>

		<!-- PERFIL -->
		<section id="perfil" class="container mx-auto px-4 py-8 md:py-16 relative">
			<div class="relative flex items-center py-6 mb-6 md:mb-8">
				<span class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 whitespace-nowrap text-6xl md:text-8xl font-black text-neutral-200/40 -z-10 select-none pointer-events-none">
					プロフィール
				</span>
				<div class="relative z-10 text-left">
					<p class="text-xs font-mono text-neutral-500 mb-2">プロフィール</p>
					<h2 class="text-3xl md:text-4xl font-bold text-left break-words">PERFIL</h2>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 relative z-10">
				<div class="md:col-span-1 order-1 md:order-1">
					<div class="relative w-full aspect-square border-2 border-black dark:border-white shadow-[4px_4px_0px_#000] dark:shadow-[4px_4px_0px_#fff] overflow-hidden bg-neutral-200 dark:bg-neutral-800">
						<img src="https://media.discordapp.net/attachments/1297263543053451274/1474116452205330564/624725424_18141028618468225_6224834856789371662_n.webp?ex=6998ad6d&is=69975bed&hm=d69839cfcf2c4f64f1ad881b46bd93025d4f5174b778ad7ec110aa7ff5dfad0c&=&format=webp&width=968&height=968" alt="Mateo Gijon - Operador 1" class="profile-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-100 z-10 filter grayscale hover:grayscale-0" />
						
						<img src="https://media.discordapp.net/attachments/1297263543053451274/1474114727864045701/IMG_8346.jpg?ex=6998abd2&is=69975a52&hm=35f0d579d6d88bf0c85038049bd647ea8abd2dc5470c03a0d5ec191025266ff9&=&format=webp&width=544&height=968" alt="Mateo Gijon - Operador 2" class="profile-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0 z-0 filter grayscale hover:grayscale-0" />
						
						<img src="https://media.discordapp.net/attachments/1297263543053451274/1474114263625764925/EA7006E8-AEE4-46B2-9F1F-7C973C38BB46.jpg?ex=6998ab64&is=699759e4&hm=5f53aa95bb2cbc1210b38028858d8361b195d8fd2cc98d4fdcbdf738b9adf36c&=&format=webp&width=542&height=967" alt="Mateo Gijon - Operador 3" class="profile-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0 z-0 filter grayscale hover:grayscale-0" />
						
						<div class="absolute bottom-2 right-2 z-20 bg-white dark:bg-black border border-black dark:border-white px-1 text-[10px] font-mono font-bold text-black dark:text-white">
							REC <span class="animate-pulse text-red-500">●</span>
						</div>
					</div>
				</div>

				<div class="md:col-span-2 order-2 md:order-2">
					<div class="border-2 border-neutral-900 dark:border-neutral-700 bg-paper dark:bg-neutral-900 shadow-[4px_4px_0px_#000] dark:shadow-[4px_4px_0px_#fff] p-4 md:p-6">
						<div class="space-y-4 text-left">
							<div>
								<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mb-1">名前</p>
								<p class="font-mono text-sm font-bold mb-1 dark:text-white">Nombre [ 名前 ]:</p>
								<p class="font-sans text-base dark:text-white">Mateo Gijon</p>
							</div>

							<div>
								<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mb-1">拠点</p>
								<p class="font-mono text-sm font-bold mb-1 dark:text-white">Base [ 拠点 ]:</p>
								<p class="font-sans text-base dark:text-white">Santiago, CL</p>
							</div>

							<div>
								<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mb-1">状態</p>
								<p class="font-mono text-sm font-bold mb-1 dark:text-white">Status [ 状態 ]:</p>
								<p class="font-sans text-base max-w-prose text-left mb-2 dark:text-white">
									Desarrollador Web Freelance en NexSecure. Especialista en <span class="bg-neutral-100 dark:bg-neutral-800 font-bold px-1">Desarrollo Web</span> y <span class="bg-green-50 dark:bg-green-900 text-green-800 dark:text-green-300 px-1 font-bold">Ciberseguridad</span>.
								</p>
								<p class="font-sans text-base max-w-prose text-left dark:text-white">
									Creación de sitios desde cero y <span class="bg-neutral-100 dark:bg-neutral-800 font-bold px-1">Software Personalizados</span> con enfoque en seguridad y eficiencia.
								</p>
							</div>

							<div>
								<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mb-1">ログ</p>
								<p class="font-mono text-sm font-bold mb-1 dark:text-white">Registro de Actividad [ ログ ]:</p>
								<p class="font-sans text-base max-w-prose text-left mb-2 dark:text-white">
									Líder de la comunidad Alt F4, gestionando eventos universitarios. Instructor de talleres de videojuegos en el CITT.
								</p>
								<p class="font-sans text-base max-w-prose text-left dark:text-white">
									Creador de <span class="bg-green-50 dark:bg-green-900 text-green-800 dark:text-green-300 px-1 font-bold">Bots</span> y sistemas de <span class="bg-green-50 dark:bg-green-900 text-green-800 dark:text-green-300 px-1 font-bold">Automatización</span> para juegos, explorando los límites de la eficiencia.
								</p>
							</div>

							<div>
								<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mb-1">履歴</p>
								<p class="font-mono text-sm font-bold mb-1 dark:text-white">Experiencia Técnica [ 履歴 ]:</p>
								<p class="font-sans text-base max-w-prose text-left dark:text-white">
									Experiencia en el área de Informática de la Municipalidad de San Joaquín. <span class="bg-neutral-100 dark:bg-neutral-800 font-bold px-1">Soporte</span> y <span class="bg-neutral-100 dark:bg-neutral-800 font-bold px-1">gestión tecnológica</span>.
								</p>
							</div>

							<div class="mb-6">
								<p class="font-mono text-sm font-bold mb-2 inline-block border-b-2 border-black dark:border-white pr-4 dark:text-white">
									INTERESES & LOGROS [ サブタスク ]:
								</p>
								
								<p class="font-sans text-base max-w-prose text-left text-neutral-800 dark:text-neutral-200 mb-3">
									Música y <span class="bg-neutral-100 dark:bg-neutral-800 font-bold px-1">gaming</span>. Me gusta explorar los límites de la <span class="bg-green-50 dark:bg-green-900 text-green-800 dark:text-green-300 px-1 font-bold">automatización</span> y entender cómo funcionan los <span class="bg-green-50 dark:bg-green-900 text-green-800 dark:text-green-300 px-1 font-bold">bots</span> en diferentes entornos.
								</p>
								
								<p class="font-sans text-base max-w-prose text-left text-neutral-800 dark:text-neutral-200 mb-3">
									En <span class="bg-neutral-100 dark:bg-neutral-800 font-bold px-1">Desarrollo Web</span>, me especializo en crear interfaces con <span class="bg-neutral-100 dark:bg-neutral-800 font-bold px-1">diseños únicos</span> y propuestas visuales arriesgadas que destacan.
								</p>
								
								<p class="font-sans text-base max-w-prose text-left text-neutral-800 dark:text-neutral-200 mb-4">
									Esa misma curiosidad técnica la aplico en proyectos de <span class="bg-green-50 dark:bg-green-900 text-green-800 dark:text-green-300 px-1 font-bold">Software</span>.
								</p>
								
								<div class="flex flex-wrap gap-3 mt-4">
									<div class="inline-flex items-center gap-3 border-2 border-black dark:border-white bg-white dark:bg-neutral-900 px-3 py-2 shadow-[2px_2px_0px_#000] dark:shadow-[2px_2px_0px_#fff] w-fit hover:-translate-y-1 hover:shadow-[4px_4px_0px_#000] dark:hover:shadow-[4px_4px_0px_#fff] transition-all cursor-default">
										<span class="font-mono text-xs font-bold text-black dark:text-white">LEAGUE OF LEGENDS</span>
										<span class="font-mono text-[10px] sm:text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900 px-1.5 py-0.5 border border-amber-200 dark:border-amber-700">MASTER [ マスター ]</span>
									</div>
									
									<div class="inline-flex items-center gap-3 border-2 border-black dark:border-white bg-white dark:bg-neutral-900 px-3 py-2 shadow-[2px_2px_0px_#000] dark:shadow-[2px_2px_0px_#fff] w-fit hover:-translate-y-1 hover:shadow-[4px_4px_0px_#000] dark:hover:shadow-[4px_4px_0px_#fff] transition-all cursor-default">
										<span class="font-mono text-xs font-bold text-black dark:text-white">APEX LEGENDS</span>
										<span class="font-mono text-[10px] sm:text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900 px-1.5 py-0.5 border border-amber-200 dark:border-amber-700">MASTER [ マスター ]</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- PROYECTOS -->
		<section id="proyectos" class="container mx-auto px-4 py-8 md:py-16 relative">
			<div class="relative flex items-center py-6 mb-6 md:mb-8">
				<span class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 whitespace-nowrap text-6xl md:text-8xl font-black text-neutral-200/40 -z-10 select-none pointer-events-none">
					プロジェクト
				</span>
				<div class="relative z-10 text-left">
					<h2 class="text-3xl md:text-4xl font-bold text-left break-words">Proyectos</h2>
				</div>
			</div>
			<div id="github-repos-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10">
				<div class="col-span-full text-center py-10 font-mono text-neutral-500 animate-pulse">
					[ CONECTANDO CON LOS SERVIDORES DE GITHUB... ]
				</div>
			</div>
		</section>

		<!-- CONTACTO -->
		<section id="contacto-terminal" class="container mx-auto px-4 py-8 md:py-16 max-w-4xl">
			<div class="relative flex items-center py-6 mb-6 md:mb-8">
				<span class="absolute -left-4 md:-left-8 top-1/2 -translate-y-1/2 whitespace-nowrap text-6xl md:text-8xl font-black text-neutral-200/40 -z-10 select-none pointer-events-none">
					お問い合わせ
				</span>
				<div class="relative z-10 text-left">
					<h2 class="text-3xl md:text-4xl font-bold text-left break-words font-mono">CONTACTO</h2>
				</div>
			</div>
			
			<div class="bg-neutral-950 border-2 border-neutral-800 shadow-[4px_4px_0px_#ccc] overflow-hidden">
				<div class="bg-neutral-900 border-b border-neutral-800 px-4 py-2 flex items-center justify-between">
					<div class="flex items-center gap-2">
						<div class="flex gap-1.5">
							<div class="w-3 h-3 rounded-full bg-red-600"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-600"></div>
							<div class="w-3 h-3 rounded-full bg-green-600"></div>
						</div>
						<span class="font-mono text-xs text-neutral-400 ml-3">root@system:~ / 通信</span>
					</div>
				</div>

				<div class="p-4 md:p-6 space-y-4">
					<div class="space-y-2 font-mono text-xs md:text-sm text-neutral-400">
						<p>> Inicializando protocolo de conexión seguro... <span class="text-green-500">[OK]</span></p>
						<p>> Estableciendo enlace con MATEO.DEV... <span class="text-green-500">[OK]</span></p>
						<p>> Sistema de comunicación listo. Esperando input del usuario...</p>
					</div>

					<form id="terminal-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-4 mt-6">
						<input type="hidden" name="access_key" value="c7fbeceb-e3c0-4282-89d3-1cbb43f27fc4" />
						<input type="hidden" name="subject" value="Nuevo contacto clasificado desde MATEO.DEV" />
						<input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

						<div class="flex items-center flex-wrap gap-2">
							<span class="text-green-500 dark:text-green-400 font-mono text-sm md:text-base flex-shrink-0">guest@user:~$</span>
							<input 
								type="text" 
								name="name"
								placeholder="ingresa_tu_nombre" 
								required
								class="bg-transparent dark:bg-neutral-900 border-none dark:border-white outline-none focus:ring-0 text-green-400 dark:text-green-300 font-mono text-sm md:text-base w-full flex-1 min-w-0 placeholder-neutral-700 dark:placeholder-neutral-500"
							/>
