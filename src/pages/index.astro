<script>
	document.addEventListener('DOMContentLoaded', () => {
		const preloader = document.getElementById('japan-preloader');
		const preloaderText = document.getElementById('preloader-text');

		if (preloader && preloaderText) {
			preloaderText.classList.add('preloader-typing');
			
			setTimeout(() => {
				preloaderText.style.borderRight = 'none';
				preloader.classList.add('preloader-invert');
				preloaderText.classList.add('text-white');
			}, 900);
			
			setTimeout(() => {
				preloader.classList.add('preloader-exit');
			}, 1400);
			
			setTimeout(() => {
				preloader.remove();
			}, 2000);
		}
	});

	document.addEventListener('DOMContentLoaded', () => {
		const teemoQuotes = [
			"Jap, dos, tres, cuatro.",
			"Sí señor.",
			"Reconoceré el terreno.",
			"Armado y preparado.",
			"Informando.",
			"¡Eso tiene que arder!",
			"¡Rápido!",
			"Nunca subestimes el poder del código de los exploradores.",
			"El tamaño no lo es todo."
		];

		const tooltipDiv = document.getElementById('teemo-tooltip');
		const dialogSpan = document.getElementById('teemo-dialog');
		if (!tooltipDiv || !dialogSpan) return;

		function teemoTalks() {
			const randomQuote = teemoQuotes[Math.floor(Math.random() * teemoQuotes.length)];
			dialogSpan.innerText = `[ Teemo : "${randomQuote}" ]`;
			
			tooltipDiv.classList.remove('opacity-0', 'invisible', 'translate-y-4');
			tooltipDiv.classList.add('opacity-100', 'visible', 'translate-y-0');
			
			setTimeout(() => {
				tooltipDiv.classList.remove('opacity-100', 'visible', 'translate-y-0');
				tooltipDiv.classList.add('opacity-0', 'invisible', 'translate-y-4');
				
				const nextTime = Math.random() * (25000 - 10000) + 10000;
				setTimeout(teemoTalks, nextTime);
			}, 4000);
		}

		setTimeout(teemoTalks, 5000);
	});

	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('terminal-form');
		const btn = document.getElementById('submit-btn');

		if (form && btn) {
			form.addEventListener('submit', function(e) {
				e.preventDefault();
				
				const originalText = btn.innerText;
				btn.innerText = '[ ENCRIPTANDO Y TRANSMITIENDO... ]';
				btn.classList.add('animate-pulse');
				btn.disabled = true;
				
				const formData = new FormData(form);
				
				fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					body: formData
				})
				.then(async (response) => {
					if (response.status == 200) {
						btn.innerText = '[ TRANSMISIÓN COMPLETADA EXITOSAMENTE ]';
						btn.classList.remove('animate-pulse', 'bg-transparent', 'text-green-500');
						btn.classList.add('bg-green-500', 'text-black');
						form.reset();
						
						setTimeout(() => {
							btn.innerText = originalText;
							btn.classList.remove('bg-green-500', 'text-black');
							btn.classList.add('bg-transparent', 'text-green-500');
							btn.disabled = false;
						}, 5000);
					} else {
						btn.innerText = '[ ERROR DE SERVIDOR: REINTENTAR ]';
						btn.classList.remove('animate-pulse', 'bg-transparent', 'text-green-500');
						btn.classList.add('bg-red-500', 'text-white');
						btn.disabled = false;
					}
				})
				.catch(error => {
					btn.innerText = '[ ERROR DE CONEXIÓN ]';
					btn.classList.remove('animate-pulse', 'bg-transparent', 'text-green-500');
					btn.classList.add('bg-red-500', 'text-white');
					btn.disabled = false;
				});
			});
		}
	});

	document.addEventListener('DOMContentLoaded', () => {
		const internalLinks = document.querySelectorAll('a[href^="#"]');
		
		internalLinks.forEach(link => {
			link.addEventListener('click', function(e) {
				e.preventDefault();
				
				const targetId = this.getAttribute('href').substring(1);
				const targetElement = document.getElementById(targetId);
				
				if (targetElement) {
					targetElement.scrollIntoView({
						behavior: 'smooth',
						block: 'start'
					});
				}
			});
		});
	});

	document.addEventListener('DOMContentLoaded', () => {
		const grid = document.getElementById('github-repos-grid');
		if (!grid) return;

		// 1. TUS PÁGINAS WEB EN PRODUCCIÓN (Siempre visibles y fijas)
		const premiumProjects = [
			{
				name: "NexSecure", subtitle: "ネクセキュア", badge: "企業 : CORPORATE",
				description: "Agencia de desarrollo web y auditorías de seguridad.",
				homepage: "https://desarrolloweb.nexsecure.cl/", isWeb: true
			},
			{
				name: "Japimax", subtitle: "ジャピマックス", badge: "エンターテインメント : ENTERTAINMENT",
				description: "Centro de Bowling y Entretenimiento Familiar en Santiago, Barrio Universitario. 13 pistas de bowling Brunswick.",
				homepage: "https://japimax.com/", isWeb: true
			},
			{
				name: "StrikeBowler", subtitle: "ストライクボウラー", badge: "サービス : SERVICE",
				description: "Servicios técnicos profesionales para negocios de bowling. Más de 24 años de experiencia en instalación, reparación y ca...",
				homepage: "https://strikebowler.cl/", isWeb: true
			},
			{
				name: "VENT", subtitle: "ベント", badge: "Eコマース : E-COMMERCE",
				description: "Plataforma de e-commerce con tienda, galería y archivo. Sistema de gestión de pedidos y catálogo digital.",
				homepage: "https://web-vent.vercel.app/", isWeb: true
			}
		];

		const username = "Poison-CL";

		// 2. OBTENER REPOSITORIOS EXTRA DE GITHUB
		fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=15`)
			.then(response => {
				if (!response.ok) throw new Error('Error en la API');
				return response.json();
			})
			.then(repos => {
				// Filtramos forks y evitamos que los repos de código de las webs premium se dupliquen
				const githubProjects = repos
					.filter(repo => !repo.fork)
					.filter(repo => !['StrikeBowler', 'Ecommerce-Vent', 'NexSecure'].includes(repo.name))
					.map(repo => ({
						name: repo.name, subtitle: "リポジトリ", badge: "コード : CODE",
						description: repo.description || 'Sin descripción disponible.',
						html_url: repo.html_url, homepage: repo.homepage,
						isWeb: !!repo.homepage
					}));

				// 3. COMBINAR Y RENDERIZAR
				renderProjects([...premiumProjects, ...githubProjects]);
			})
			.catch(error => {
				console.warn("API Error (GitHub). Cargando solo páginas web premium.");
				// Fallback: Si GitHub falla, tus proyectos más importantes siguen ahí
				renderProjects(premiumProjects);
			});

		// FUNCIÓN DE RENDERIZADO (Estética Japan Core)
		function renderProjects(projects) {
			grid.innerHTML = projects.map(repo => {
				const labelType = repo.isWeb ? "WEB" : "REPO";
				const linkUrl = repo.isWeb && repo.homepage ? repo.homepage : (repo.html_url || "#");
				const linkText = repo.isWeb ? "VISITAR (訪問)" : "GITHUB (ソース)";
				const buttonClass = repo.isWeb 
					? "bg-white dark:bg-neutral-900 text-black dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 shadow-[4px_4px_0px_#000] dark:shadow-[4px_4px_0px_#fff] hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all" 
					: "bg-black dark:bg-white text-white dark:text-black hover:bg-neutral-800 dark:hover:bg-neutral-100 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] dark:shadow-[4px_4px_0px_rgba(255,255,255,0.5)] hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all";
				return `
					<article class="bg-white dark:bg-neutral-900 border-2 border-black dark:border-white shadow-[4px_4px_0px_#000] dark:shadow-[4px_4px_0px_#fff] flex flex-col h-full relative">
						<div class="p-4 border-b-2 border-black dark:border-white flex justify-between items-start bg-neutral-50/50 dark:bg-neutral-800/50">
							<div>
								<h3 class="font-bold text-lg text-black dark:text-white font-mono break-words">${repo.name} <span class="text-xs text-neutral-500 dark:text-neutral-400 font-normal hidden md:inline-block">/ ${repo.subtitle}</span></h3>
							</div>
							<div class="flex flex-col items-end gap-2">
								<span class="text-xs font-bold text-green-600 dark:text-green-400 flex items-center gap-1 font-mono">
									<span class="w-2 h-2 rounded-full bg-green-500 dark:bg-green-400 animate-pulse"></span> EN LÍNEA [ 稼働中 ]
								</span>
								<span class="text-[10px] border border-black dark:border-white px-1 font-mono text-black dark:text-white">[ ${labelType} ]</span>
							</div>
						</div>
						<div class="p-4 flex-grow flex flex-col justify-between">
							<div class="mb-4">
								<div class="inline-block border border-neutral-300 dark:border-neutral-600 text-neutral-500 dark:text-neutral-400 text-[10px] px-2 py-1 mb-3 font-mono">
									[ ${repo.badge} ]
								</div>
								<p class="text-sm text-neutral-700 dark:text-neutral-300 font-mono break-words">${repo.description}</p>
							</div>
							<a href="${linkUrl}" target="_blank" rel="noopener noreferrer" class="block text-center border-2 border-black dark:border-white py-2 px-4 font-bold font-mono ${buttonClass}">
								${linkText}
							</a>
						</div>
					</article>
				`;
			}).join('');
		}
	});

	document.addEventListener('DOMContentLoaded', () => {
		const slides = document.querySelectorAll('.profile-slide');
		if (slides.length > 0) {
			let currentSlide = 0;
			setInterval(() => {
				// 1. Quitar visibilidad a la foto actual
				slides[currentSlide].classList.remove('opacity-100', 'z-10');
				slides[currentSlide].classList.add('opacity-0', 'z-0');
				// 2. Calcular cuál es la siguiente foto (vuelve a 0 si llega al final)
				currentSlide = (currentSlide + 1) % slides.length;
				// 3. Dar visibilidad a la nueva foto
				slides[currentSlide].classList.remove('opacity-0', 'z-0');
				slides[currentSlide].classList.add('opacity-100', 'z-10');
			}, 3500); // Cambia cada 3.5 segundos
		}
	});

	document.addEventListener('DOMContentLoaded', () => {
		const themeToggleBtn = document.getElementById('theme-toggle');
		// Seleccionamos la etiqueta <html> que es donde Tailwind busca la clase
		const htmlElement = document.documentElement;
		
		if (themeToggleBtn) {
			themeToggleBtn.addEventListener('click', function() {
				// Alternar la clase 'dark' en el HTML
				htmlElement.classList.toggle('dark');
				
				// Comprobación por consola (F12)
				const isDark = htmlElement.classList.contains('dark');
				console.log("Sistema cambiado a modo:", isDark ? "OSCURO" : "CLARO");
				
				// Guardar preferencia
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			});
		} else {
			console.error("ERROR: No se encontró el botón con ID 'theme-toggle'");
		}
	});
</script>
