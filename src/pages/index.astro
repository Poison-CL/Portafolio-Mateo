<!-- STYLES -->
<style>
	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(-100% / 2));
		}
	}

	.animate-marquee {
		animation: marquee 40s linear infinite;
		width: fit-content;
	}

	@keyframes pulse {
		0%, 100% {
			opacity: 1;
		}
		50% {
			opacity: 0.5;
		}
	}

	.animate-pulse {
		animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}

	@keyframes float-slow {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-12px); }
	}

	.animate-float-slow {
		animation: float-slow 4s ease-in-out infinite;
	}

	.pixelated {
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		image-rendering: crisp-edges;
	}

	@keyframes typing {
		from { width: 0; }
		to { width: 100%; }
	}

	@keyframes blink-caret {
		from, to { border-color: transparent; }
		50% { border-color: currentColor; }
	}

	@keyframes invert-colors {
		0% { background-color: white; color: black; }
		50% { background-color: black; color: white; }
		100% { background-color: black; color: white; }
	}

	@keyframes slide-up-reveal {
		0% { transform: translateY(0); }
		100% { transform: translateY(-100%); }
	}

	.preloader-typing {
		border-right: 3px solid;
		white-space: nowrap;
		overflow: hidden;
		animation: typing 1.5s steps(15, end) forwards, blink-caret .75s step-end infinite;
	}

	.preloader-invert {
		animation: invert-colors 0.4s cubic-bezier(0.645, 0.045, 0.355, 1.000) forwards;
	}

	.preloader-exit {
		animation: slide-up-reveal 0.8s cubic-bezier(0.77, 0, 0.175, 1) forwards;
	}
</style>

<!-- SCRIPTS -->
<script>
	document.addEventListener('DOMContentLoaded', () => {
		const preloader = document.getElementById('japan-preloader');
		const preloaderText = document.getElementById('preloader-text');

		if (preloader && preloaderText) {
			preloaderText.classList.add('preloader-typing');
			
			setTimeout(() => {
				preloaderText.style.borderRight = 'none';
				preloader.classList.add('preloader-invert');
				preloaderText.classList.add('text-white');
			}, 1800);
			
			setTimeout(() => {
				preloader.classList.add('preloader-exit');
			}, 2500);
			
			setTimeout(() => {
				preloader.remove();
			}, 3500);
		}
	});

	document.addEventListener('DOMContentLoaded', () => {
		const teemoQuotes = [
			"Jap, dos, tres, cuatro.",
			"Sí señor.",
			"Reconoceré el terreno.",
			"Armado y preparado.",
			"Informando.",
			"¡Eso tiene que arder!",
			"¡Rápido!",
			"Nunca subestimes el poder del código de los exploradores.",
			"El tamaño no lo es todo."
		];

		const tooltipDiv = document.getElementById('teemo-tooltip');
		const dialogSpan = document.getElementById('teemo-dialog');
		if (!tooltipDiv || !dialogSpan) return;

		function teemoTalks() {
			const randomQuote = teemoQuotes[Math.floor(Math.random() * teemoQuotes.length)];
			dialogSpan.innerText = `[ Teemo : "${randomQuote}" ]`;
			
			tooltipDiv.classList.remove('opacity-0', 'invisible', 'translate-y-4');
			tooltipDiv.classList.add('opacity-100', 'visible', 'translate-y-0');
			
			setTimeout(() => {
				tooltipDiv.classList.remove('opacity-100', 'visible', 'translate-y-0');
				tooltipDiv.classList.add('opacity-0', 'invisible', 'translate-y-4');
				
				const nextTime = Math.random() * (25000 - 10000) + 10000;
				setTimeout(teemoTalks, nextTime);
			}, 4000);
		}

		setTimeout(teemoTalks, 5000);
	});

	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('terminal-form');
		const btn = document.getElementById('submit-btn');

		if (form && btn) {
			form.addEventListener('submit', function(e) {
				e.preventDefault();
				
				const originalText = btn.innerText;
				btn.innerText = '[ ENCRIPTANDO Y TRANSMITIENDO... ]';
				btn.classList.add('animate-pulse');
				btn.disabled = true;
				
				const formData = new FormData(form);
				
				fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					body: formData
				})
				.then(async (response) => {
					if (response.status == 200) {
						btn.innerText = '[ TRANSMISIÓN COMPLETADA EXITOSAMENTE ]';
						btn.classList.remove('animate-pulse', 'bg-transparent', 'text-green-500');
						btn.classList.add('bg-green-500', 'text-black');
						form.reset();
						
						setTimeout(() => {
							btn.innerText = originalText;
							btn.classList.remove('bg-green-500', 'text-black');
							btn.classList.add('bg-transparent', 'text-green-500');
							btn.disabled = false;
						}, 5000);
					} else {
						btn.innerText = '[ ERROR DE SERVIDOR: REINTENTAR ]';
						btn.classList.remove('animate-pulse', 'bg-transparent', 'text-green-500');
						btn.classList.add('bg-red-500', 'text-white');
						btn.disabled = false;
					}
				})
				.catch(error => {
					btn.innerText = '[ ERROR DE CONEXIÓN ]';
					btn.classList.remove('animate-pulse', 'bg-transparent', 'text-green-500');
					btn.classList.add('bg-red-500', 'text-white');
					btn.disabled = false;
				});
			});
		}
	});

	document.addEventListener('DOMContentLoaded', () => {
		const internalLinks = document.querySelectorAll('a[href^="#"]');
		
		internalLinks.forEach(link => {
			link.addEventListener('click', function(e) {
				e.preventDefault();
				
				const targetId = this.getAttribute('href').substring(1);
				const targetElement = document.getElementById(targetId);
				
				if (targetElement) {
					targetElement.scrollIntoView({
						behavior: 'smooth',
						block: 'start'
					});
				}
			});
		});
	});

	document.addEventListener('DOMContentLoaded', () => {
		const grid = document.getElementById('github-repos-grid');
		if (!grid) return;

		const username = "Poison-CL";
		fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=9`)
			.then(response => {
				if (!response.ok) throw new Error('Error en la API');
				return response.json();
			})
			.then(repos => {
				const myProjects = repos.filter(repo => !repo.fork);

				grid.innerHTML = myProjects.map(repo => {
					const isWeb = repo.homepage && repo.homepage !== "";
					const labelType = isWeb ? "WEB" : "REPO";
					const linkUrl = isWeb ? repo.homepage : repo.html_url;
					const linkText = isWeb ? "VISITAR (訪問)" : "GITHUB (ソース)";
					const buttonClass = isWeb 
						? "bg-white text-black hover:bg-neutral-100 shadow-[4px_4px_0px_#000] hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all" 
						: "bg-black text-white hover:bg-neutral-800 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all";
					const statusHtml = isWeb 
						? `<span class="text-xs font-bold text-green-600 flex items-center gap-1 font-mono">
							<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> EN LÍNEA [ 稼働中 ]
						</span>`
						: `<span class="text-xs font-bold text-neutral-500 flex items-center gap-1 font-mono">
							<span class="w-2 h-2 rounded-full bg-neutral-500"></span> CÓDIGO [ ソース ]
						</span>`;
					
					return `
						<article class="bg-white border-2 border-black shadow-[4px_4px_0px_#000] flex flex-col h-full">
							<div class="p-4 border-b-2 border-black flex justify-between items-start bg-neutral-50/50">
								<div>
									<h3 class="font-bold text-lg text-black font-mono">${repo.name}</h3>
									<span class="text-xs text-neutral-500 font-mono">/ ソース</span>
								</div>
								<div class="flex flex-col items-end gap-2">
									${statusHtml}
									<span class="text-[10px] border border-black px-1 font-mono">[ ${labelType} ]</span>
								</div>
							</div>
							<div class="p-4 flex-grow flex flex-col justify-between">
								<div class="mb-4">
									<p class="text-sm text-neutral-700 font-mono">${repo.description || 'Sin descripción disponible.'}</p>
								</div>
								<a href="${linkUrl}" target="_blank" rel="noopener noreferrer" class="block text-center border-2 border-black py-2 px-4 font-bold font-mono ${buttonClass}">
									${linkText}
								</a>
							</div>
						</article>
					`;
				}).join('');
			})
			.catch(error => {
				console.error("Error cargando repositorios:", error);
				grid.innerHTML = `
					<div class="col-span-full border-2 border-red-500 p-6 bg-red-50 text-red-600 font-mono text-center">
						> [ ERROR: ACCESO DENEGADO A LA BASE DE DATOS DE GITHUB ]
					</div>
				`;
			});
	});
</script>
